# Optional LLM query-task planner. Leave provider=none for deterministic-only mode.
BHUVISION_LLM_PROVIDER=none
BHUVISION_LLM_API_KEY=
BHUVISION_LLM_MODEL=
BHUVISION_LLM_BASE_URL=
BHUVISION_LLM_TIMEOUT_SECONDS=10

# BLIP VQA + Captioning (CPU-friendly, auto-downloads from HuggingFace)
BHUVISION_BLIP_ENABLED=true
BHUVISION_BLIP_DEVICE=cpu

# Grounding DINO open-vocabulary object detection & grounding (auto-downloads from HuggingFace)
BHUVISION_GROUNDING_DINO_ENABLED=true
BHUVISION_GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
BHUVISION_GROUNDING_DINO_BOX_THRESHOLD=0.25
BHUVISION_GROUNDING_DINO_TEXT_THRESHOLD=0.25
BHUVISION_GROUNDING_DINO_DEVICE=auto

# GeoChat-7B Remote Sensing Vision-Language Model
BHUVISION_GEOCHAT_ENABLED=true
BHUVISION_GEOCHAT_BACKEND=sagemaker
BHUVISION_GEOCHAT_ENDPOINT_NAME=bhuvision-geochat-7b
AWS_DEFAULT_REGION=us-east-1
HF_TOKEN=
