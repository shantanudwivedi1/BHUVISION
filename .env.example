# Offline local-only mode. Model weights are bundled in the repository.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
BHUVISION_LLM_PROVIDER=none
BHUVISION_LLM_API_KEY=
BHUVISION_LLM_MODEL=
BHUVISION_LLM_BASE_URL=
BHUVISION_LLM_TIMEOUT_SECONDS=10

# BLIP VQA + Captioning (uses local repository files)
BHUVISION_BLIP_ENABLED=true
BHUVISION_BLIP_DEVICE=cpu
# Default model weights are bundled in ./models.

# Grounding DINO open-vocabulary detection (local repository files)
BHUVISION_GROUNDING_DINO_ENABLED=true
# Default model weights are bundled in ./models.
BHUVISION_GROUNDING_DINO_BOX_THRESHOLD=0.25
BHUVISION_GROUNDING_DINO_TEXT_THRESHOLD=0.25
BHUVISION_GROUNDING_DINO_DEVICE=auto

# Remote GeoChat inference is disabled. Use the bundled local models.
BHUVISION_GEOCHAT_ENABLED=false
